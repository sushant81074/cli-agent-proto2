      "baseDelayMs": 250,
      "maxDelayMs": 4000
    }
  },
  "summarize": {
    "stuffMaxTokens": 12000,
    "chunkTokens": 6000,
    "overlapTokens": 400,
    "mapConcurrency": 4
  }
}
