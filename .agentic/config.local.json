{
  "llm": {
    "baseUrl": "https://openrouter.ai/api/v1",
    "apiKeyEnv": "OPENROUTER_KEY",
    "models": {
      "fast": "cohere/north-mini-code:free",
      "balanced": "openai/gpt-oss-120b",
      "deep": "poolside/laguna-xs-2.1-free",
      "heavy-logic": "qwen/qwen3-coder:free",
      "planning": "nvidia/nemotron-3-ultra:free",
      "agentic": "poolside/laguna-s-2.1:free",
      "fallback": "openrouter/free"
    },
    "routing": {
      "allowFallbacks": true,
      "requireParameters": false,
      "dataCollection": "deny"
    },
    "fallbackModels": [],
    "catalogTtlMs": 86400000,
    "maxTokens": 4096,
    "retry": {
      "maxAttempts": 3,
      "baseDelayMs": 250,
      "maxDelayMs": 4000
    }
  },
  "summarize": {
    "stuffMaxTokens": 12000,
    "chunkTokens": 6000,
    "overlapTokens": 400,
    "mapConcurrency": 4
  }
}
