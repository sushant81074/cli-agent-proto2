{
  "llm": {
    "baseUrl": "https://openrouter.ai/api/v1",
    "apiKeyEnv": "",
    "models": {
      "fast": "openrouter/free",
      "balanced": "openai/gpt-oss-120b",
      "deep": "poolside/laguna-xs-2.1-free"
    },
    "routing": {
      "allowFallbacks": true,
      "requireParameters": false,
      "dataCollection": "deny"
    },
    "fallbackModels": [],
